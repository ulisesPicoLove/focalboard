# Picoboard: variables de entorno
#
# Copia este archivo a `.env` (que NO se sube a git) o, mejor, guarda estos valores
# en Infisical y arranca con:
#
#     infisical run --env=<entorno> -- ./bin/focalboard-server
#
# El servidor Go NO lee archivos `.env` por sí mismo: necesita que las variables estén en el
# entorno del proceso (Infisical, `export`, `docker compose --env-file`, etc.).
#
# Reglas:
#   - Cada variable de configuración se llama FOCALBOARD_ + el nombre de la clave en mayúsculas.
#   - Una variable vacía se ignora (el valor sale de config.json o del valor por defecto).
#   - Las líneas comentadas con `#` muestran el valor por defecto actual. Descomenta solo lo
#     que quieras cambiar.
#   - [config.json] = la variable solo se aplica si config.json ya contiene esa clave. El
#     config.json del repositorio (y el de docker/) las contiene.
#
# Nunca escribas aquí secretos reales: este archivo se sube a git.


# ==============================================================================
# Autenticación: inicio de sesión con Google Workspace (docs/google-sso.md)
# ==============================================================================

# Modo de autenticación: native (usuario y contraseña) | google | mattermost (solo como plugin)
FOCALBOARD_AUTHMODE=google

# Obligatorias cuando FOCALBOARD_AUTHMODE=google. Si falta alguna, el servidor no arranca.
# Se crean en Google Cloud Console: Credenciales -> ID de cliente de OAuth -> Aplicación web.
# URI de redirección autorizada: <FOCALBOARD_SERVERROOT>/oauth/google/callback
FOCALBOARD_GOOGLE_CLIENT_ID=
FOCALBOARD_GOOGLE_CLIENT_SECRET=
# Único dominio de Workspace que puede entrar, por ejemplo: empresa.com
FOCALBOARD_GOOGLE_ALLOWED_DOMAIN=


# ==============================================================================
# Servidor
# ==============================================================================

# URL pública por la que entran los usuarios, con https en producción. De aquí salen la URI de
# retorno de Google y la cookie Secure.
FOCALBOARD_SERVERROOT=http://localhost:8000

# Puerto en el que escucha el servidor
# FOCALBOARD_PORT=8000

# Marca como Secure la cookie temporal del inicio de sesión con Google. Ya se activa sola si
# FOCALBOARD_SERVERROOT empieza por https:// (la sesión en sí viaja en una cabecera, no en cookie).
# FOCALBOARD_SECURECOOKIE=false

# [config.json] El servidor sirve HTTPS él mismo con ./cert/cert.pem y ./cert/key.pem. Si falta
# alguno de los dos archivos, sirve HTTP sin avisar. Detrás de un proxy que ya termina TLS, déjalo en false.
# FOCALBOARD_USESSL=false

# Carpeta con la webapp compilada (la que genera `make webapp`)
# FOCALBOARD_WEBPATH=./webapp/pack

# Prefijo de ruta si Picoboard vive bajo una subruta (por ejemplo /boards). No lleva el prefijo
# FOCALBOARD_ porque lo lee directamente el servidor web.
# FOCALBOARD_HTTP_SERVER_BASEPATH=

# Escucha solo en localhost:<puerto>, así que no se puede entrar desde otras máquinas
# (útil para uso de escritorio o detrás de un proxy en el mismo equipo)
# FOCALBOARD_LOCALONLY=false

# Socket Unix para las operaciones de administración locales
# FOCALBOARD_ENABLELOCALMODE=false
# FOCALBOARD_LOCALMODESOCKETLOCATION=/var/tmp/focalboard_local.socket

# Permite compartir tableros con un enlace público (sin iniciar sesión)
# FOCALBOARD_ENABLEPUBLICSHAREDBOARDS=false

# Dirección del endpoint de métricas de Prometheus, por ejemplo :9092. Vacío = desactivado.
# FOCALBOARD_PROMETHEUSADDRESS=


# ==============================================================================
# Base de datos
# ==============================================================================

# Tipo: sqlite3 | postgres | mysql | mariadb
# FOCALBOARD_DBTYPE=sqlite3

# [config.json] Cadena de conexión. Contiene credenciales: guárdala en Infisical, no aquí.
#   sqlite3:  ./focalboard.db?_busy_timeout=5000
#   postgres: postgres://usuario:CLAVE@host:5432/boards?sslmode=disable
#   mysql:    usuario:CLAVE@tcp(host:3306)/boards?charset=utf8mb4,utf8&writeTimeout=30s
# FOCALBOARD_DBCONFIG=./focalboard.db?_busy_timeout=5000

# Prefijo opcional para los nombres de las tablas
# FOCALBOARD_DBTABLEPREFIX=

# Intentos de conexión al arrancar antes de rendirse
# FOCALBOARD_DBPINGATTEMPTS=5


# ==============================================================================
# Archivos adjuntos
# ==============================================================================

# Dónde se guardan: local | amazons3 (la configuración de S3 va en config.json, no hay variable)
# FOCALBOARD_FILESDRIVER=local
# FOCALBOARD_FILESPATH=./files


# ==============================================================================
# Sesiones
# ==============================================================================

# [config.json] Segundos que dura una sesión (2592000 = 30 días) y cada cuánto se renueva
# FOCALBOARD_SESSION_EXPIRE_TIME=2592000
# FOCALBOARD_SESSION_REFRESH_TIME=18000


# ==============================================================================
# Privacidad y cómo se muestran los usuarios
# ==============================================================================

# Telemetría. Para uso interno conviene desactivarla.
FOCALBOARD_TELEMETRY=false
# FOCALBOARD_TELEMETRYID=

# Cómo se muestra a cada persona: username | nickname_full_name | full_name
# FOCALBOARD_TEAMMATENAMEDISPLAY=username
# FOCALBOARD_SHOWEMAILADDRESS=false
# FOCALBOARD_SHOWFULLNAME=false


# ==============================================================================
# Logs y auditoría
# ==============================================================================

# [config.json] Archivos de configuración de logs y de auditoría (formato JSON de logr)
# FOCALBOARD_LOGGING_CFG_FILE=
# FOCALBOARD_AUDIT_CFG_FILE=


# ==============================================================================
# Modo de un solo usuario (aplicación de escritorio, `--single-user`)
# ==============================================================================

# Obligatoria solo cuando el servidor se arranca con --single-user. Debe ser un valor secreto y largo.
# FOCALBOARD_SINGLE_USER_TOKEN=


# ==============================================================================
# Compilación
# ==============================================================================

# Lo pide el README para el entorno de compilación (`make prebuild`)
# EXCLUDE_ENTERPRISE="1"


# ==============================================================================
# Solo para ejecutar las pruebas (no hacen falta para usar la aplicación)
# ==============================================================================

# FOCALBOARD_UNIT_TESTING=1
# Base de datos de las pruebas del store: sqlite (por defecto) | mysql | mariadb | postgres
# FOCALBOARD_STORE_TEST_DB_TYPE=sqlite
# FOCALBOARD_STORE_TEST_DOCKER_PORT=
# FOCALBOARD_STORE_TEST_CONN_STRING=
# Pruebas de S3 (se omiten si no están)
# FOCALBOARD_TEST_S3_ENDPOINT=
# FOCALBOARD_TEST_S3_ACCESS_KEY=
# FOCALBOARD_TEST_S3_SECRET_KEY=


# ==============================================================================
# NO se pueden poner por variable de entorno (van en config.json)
# ==============================================================================
# maxfilesize, secret, filess3config (credenciales de S3), enable_data_retention,
# data_retention_days, notify_freq_card_seconds, notify_freq_board_seconds,
# logging_cfg_json, audit_cfg_json.
# Los valores simples de esa lista se probaron uno por uno: el servidor los ignora si vienen del
# entorno. También van en config.json las que son estructuras (featureFlags, webhook_update y el
# bloque de S3), que no se probaron por entorno.
