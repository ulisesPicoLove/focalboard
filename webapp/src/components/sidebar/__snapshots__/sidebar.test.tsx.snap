              class="MenuWrapper"
              role="button"
            >
              <div
                class="logo"
              >
                <div
                  class="logo-title"
                >
                  <span
                    class="PicoboardLogo Icon"
                  >
                    <img
                      alt="Picoboard"
                      src="test-file-stub"
                    />
                  </span>
                  <span>
                    Picoboard
                  </span>
                  <div
                    class="versionFrame"
                  >
                    <div
                      class="version"
                      title="v8.0.0"
                    >
                      v8.0.0
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="octo-spacer"
      />
      <div
        class="sidebarSwitcher"
      >
        <button
          class="IconButton"
          type="button"
        >
          <svg
            class="HideSidebarIcon Icon"
            viewBox="0 0 100 100"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polyline
              points="80,20 50,50 80,80"
            />
            <polyline
              points="50,20 20,50, 50,80"
            />
          </svg>
        </button>
      </div>
    </div>
    <div
      class="WorkspaceTitle"
    />
    <div
      class="BoardsSwitcherWrapper"
    >
      <div
        aria-haspopup="dialog"
        class="BoardsSwitcher"
        role="button"
        tabindex="0"
      >
        <i
          class="CompassIcon icon-magnify MagnifyIcon"
        />
        <div>
          <span>
            Find Boards
          </span>
        </div>
      </div>
    </div>
    <div
      class="octo-sidebar-list"
      data-rfd-droppable-context-id=":rc:"
      data-rfd-droppable-id="lhs-categories"
    >
      <div
        data-rfd-draggable-context-id=":rc:"
        data-rfd-draggable-id="category1"
      >
        <div
          class="SidebarCategory"
        >
          <div
            class="categoryBoardsDroppableArea"
            data-rfd-droppable-context-id=":rc:"
            data-rfd-droppable-id="category1"
          >
            <div
              class="octo-sidebar-item category expanded "
            >
              <div
                aria-describedby="rfd-hidden-text-:rc:-hidden-text-:rd:"
                aria-expanded="true"
                class="octo-sidebar-title category-title"
                data-rfd-drag-handle-context-id=":rc:"
                data-rfd-drag-handle-draggable-id="category1"
                draggable="false"
                role="button"
                tabindex="0"
                title="Category 1"
              >
                <i
                  class="CompassIcon icon-chevron-down ChevronDownIcon"
                />
                Category 1
                <div
                  class="sidebarCategoriesTour"
                />
              </div>
              <div
                class=""
              >
                <div
                  aria-label="menuwrapper"
                  class="MenuWrapper"
                  role="button"
                >
                  <button
                    class="IconButton"
                    type="button"
                  >
                    <i
                      class="CompassIcon icon-dots-horizontal OptionsIcon"
                    />
                  </button>
                </div>
              </div>
            </div>
            <div>
              <div
                class="octo-sidebar-item subitem no-views"
              >
                No boards inside
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="octo-spacer"
    />
    <div
      class="add-board"
      role="button"
      tabindex="0"
    >
      + Add board
    </div>
    <div
      class="SidebarSettingsMenu"
    >
      <div
        aria-label="menuwrapper"
        class="MenuWrapper"
        role="button"
      >
        <div
          class="menu-entry"
        >
          Settings
        </div>
      </div>
    </div>
  </nav>
</div>
`;

