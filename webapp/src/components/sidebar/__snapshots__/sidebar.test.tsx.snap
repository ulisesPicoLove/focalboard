exports[`components/sidebarSidebar dont show hidden boards 1`] = `
<div>
  <nav
    aria-label="Boards"
    class="Sidebar octo-sidebar"
  >
    <div
      class="octo-sidebar-header"
    >
      <div
        class="heading"
      >
        <div
          class="SidebarUserMenu"
        >
          <div
            class="ModalWrapper"
          >
